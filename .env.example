# Copy this file to .env and fill in what you need. .env is ignored by Git;
# never commit real keys. Keys are only read on the server.

# Which AI provider runs the chat and report: claude (default) or gemini.
# The results assistant needs claude.
LLM_PROVIDER=

# Optional: override the model (default claude-sonnet-5-5, or gemini-flash-latest).
LLM_MODEL=

# Key for LLM_PROVIDER=claude (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Key for LLM_PROVIDER=gemini (https://aistudio.google.com).
GEMINI_API_KEY=

# Optional: AI messages allowed per browser session (default 20).
INTAKE_MESSAGE_CAP=
